# ── 应用基础信息 ──
# 应用名，用于 /api/v1/system 响应的 service_name 与启动快照
APP_NAME=axum-service-scaffold
# 运行环境。production 会触发三项启动校验：debug 构建拒绝启动、示例 JWT_SECRET 拒绝启动、
# MIDDLEWARE_TRUSTED_PROXIES 不得信任全部对端；同时作为 HSTS 的默认开关来源。
# 调试路由（dev-login / dev-transfer）由构建类型决定，文档路由由 docs feature 决定，均与取值无关
APP_ENV=development

# ── Web 服务监听 ──
# 监听地址；容器部署通常用 0.0.0.0
SERVER_HOST=127.0.0.1
# 监听端口
SERVER_PORT=8080

# ── 数据库（仅支持 SQLite）──
# 连接串，必须以 sqlite: 开头；迁移文件与补列/建索引逻辑都是 SQLite 语法，其他 scheme 启动即拒
DATABASE_URL=sqlite://scaffold.db?mode=rwc
# 连接池最大连接数；SQLite 写入是串行的，该值过大只会增加锁竞争
DATABASE_MAX_CONNECTIONS=10
# 连接池最小连接数（常驻连接），必须 ≤ 最大连接数
DATABASE_MIN_CONNECTIONS=1
# 建立新连接的超时（秒），超时视为连接失败；必须大于 0
DATABASE_CONNECT_TIMEOUT_SECS=8
# 空闲连接回收时间（秒），超过该时长未使用的连接被关闭；必须大于 0
DATABASE_IDLE_SECS=60
# 是否打印 SQLx 的 SQL 日志；生产环境建议保持 false，避免把 SQL 与参数写进日志
DATABASE_SQLX_LOGGING=false

# ── JWT ──
# 签名密钥，至少 32 字符且必填；生产环境禁止使用本文件的示例值（否则拒绝启动）
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-characters
# 签发方（iss），校验令牌时比对
JWT_ISSUER=axum-service-scaffold
# 受众（aud），校验令牌时比对
JWT_AUDIENCE=axum-service-clients
# 访问令牌有效期（分钟），必须大于 0
JWT_ACCESS_TOKEN_TTL_MINUTES=120

# ── 日志 ──
# 日志过滤规则（tracing 的 EnvFilter 语法）；写错（如不存在的级别）会拒绝启动，不会静默回退
LOG_FILTER=info,tower_http=info
# 日志时间戳的时区偏移（小时），仅影响展示，不影响 timestamp 语义
LOG_UTC_OFFSET_HOUR=8
# 日志时间戳的时区偏移（分钟）
LOG_UTC_OFFSET_MINUTE=0
# 日志时间戳的时区偏移（秒）
LOG_UTC_OFFSET_SECOND=0
# 日志文件名前缀，如 app.2026-04-22.log
LOG_FILENAME_PREFIX=app
# 日志文件名后缀
LOG_FILENAME_SUFFIX=log
# 时间轮转策略：DAILY / HOURLY / MINUTELY / WEEKLY / NEVER，其他取值拒绝启动
LOG_ROTATION=DAILY
# 已归档日志文件的保留数量，超出的按修改时间删除最旧的；必须大于 0
LOG_MAX_LOG_FILES=60
# 日志目录；相对路径以进程工作目录为基准，目录不存在会自动创建
LOG_OUT_DIR=./log
# 分批落盘：内存缓冲满 N 条触发一次落盘；必须大于 0
LOG_BATCH_MAX_EVENTS=50
# 分批落盘：距上次落盘超过 N 秒强制落盘一次；必须大于 0。进程退出时剩余缓冲也会落盘
LOG_BATCH_FLUSH_INTERVAL_SECS=3

# ── 中间件容量 ──
# 单请求整体超时（秒），覆盖排队等待与处理，超时返回 408 Json 响应；必须大于 0
MIDDLEWARE_REQUEST_TIMEOUT_SECS=10
# 请求体最大字节数，超限返回 413；按 Content-Length 先行拒绝，分块传输按实际累计字节拒绝
MIDDLEWARE_MAX_BODY_BYTES=2097152
# 全局同时在途请求上限，超出的请求进入背压队列等待；必须大于 0
MIDDLEWARE_MAX_CONCURRENCY=256
# 背压等待队列深度，队列满后立即返回 503，不无限堆积；必须大于 0
MIDDLEWARE_BACKPRESSURE_QUEUE=256
# 进程级全局限速额度：每个周期允许的请求数，超出返回 429；必须大于 0。单实例语义，多实例需网关兜底
MIDDLEWARE_RATE_LIMIT_REQUESTS=32768
# 限流周期长度（秒），必须大于 0
MIDDLEWARE_RATE_LIMIT_PERIOD_SECS=1
# HSTS 开关。默认跟随 APP_ENV（production 开启）；显式赋值（含 false）会覆盖该默认值，故此处注释掉。
# 仅在全链路 HTTPS 确认后才应开启
# MIDDLEWARE_HSTS_ENABLED=false
# 允许跨域的来源白名单，逗号分隔（如 https://a.example,https://b.example）；每个条目必须是合法 header 值。
# 留空表示不下发任何 CORS 放行头（等于关闭），单值 * 表示放行全部来源（生产环境不建议）
MIDDLEWARE_CORS_ALLOWED_ORIGINS=

# ── 客户端保护：按真实来源 IP 限并发与请求量，同一出口共用额度 ──
# 可信反向代理网段（CIDR 或单个 IP），逗号分隔。只有直连对端落在此范围内时才采信
# X-Forwarded-For，并按信任链从右向左剥离可信代理；留空则完全忽略转发头（即使用直连对端 IP）。
# 不使用 X-Real-IP / Forwarded 兜底，转发头重复或参与解析的地址非法返回 400。
# 单值 * 表示信任所有直连对端，等于完全采信客户端自报的 X-Forwarded-For：仅用于本地调试，
# 生产环境会拒绝启动，且不得与具体条目混写。例：127.0.0.1/32,::1/128
MIDDLEWARE_TRUSTED_PROXIES=
# 单个来源 IP 同时在途的请求数上限，含全局排队阶段；超出返回 429，不猜测重试时间；必须大于 0
MIDDLEWARE_CLIENT_MAX_CONCURRENCY=32
# 单个来源 IP 在固定窗口内允许的请求数；超出返回 429 并带 Retry-After；必须大于 0
MIDDLEWARE_CLIENT_RATE_LIMIT_REQUESTS=1024
# 速率计数的固定窗口长度（秒），窗口满后计数重置；必须大于 0 且不得大于 MIDDLEWARE_CLIENT_IDLE_SECS
MIDDLEWARE_CLIENT_RATE_LIMIT_PERIOD_SECS=1
# 客户端注册表容量上限，即最多同时跟踪多少个来源 IP；注册表满时新来源返回 503，活动项不驱逐；必须大于 0
MIDDLEWARE_CLIENT_MAX_ENTRIES=16384
# 空闲来源保留期（秒），超过该时长未出现的条目被清理；必须大于 0 且不得小于速率窗口
MIDDLEWARE_CLIENT_IDLE_SECS=60
# 慢请求诊断阈值（毫秒），仅慢请求/超时/5xx 输出阶段汇总；必须大于 0
MIDDLEWARE_SLOW_REQUEST_MS=1000
