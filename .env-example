# ── 应用基础信息 ──
# 应用名，只用于日志与启动快照展示
APP_NAME=axum-service-scaffold
# 运行环境。production 会触发生产环境启动校验（构建画像、安全中间件开关、Host 白名单、示例密钥）；
# 其余任何取值都视为非生产：调试路由（dev-login/dev-transfer）注册、HSTS 默认关闭、文档路由可挂载
APP_ENV=development
# 生产环境下误用 debug 构建或 docs feature 构建时，默认拒绝启动（调试登录可伪造任意身份）。
# 设为 true 表示放弃这条校验：仅豁免「拒绝启动」，调试路由与文档路由仍然不会注册。危险开关
APP_ALLOW_INSECURE_PRODUCTION=false

# ── 连接层（应用内 accept 循环 + hyper 连接构建器，不依赖反向代理生效）──
# 监听地址；容器部署通常用 0.0.0.0
SERVER_HOST=127.0.0.1
# 监听端口
SERVER_PORT=8080
# 并发 TCP 连接上限（保护文件描述符，含空闲连接）；超限的新连接被立即关闭并计入
# http_rejections_total{reason="connection_limit"}。需保证该值加数据库连接、日志句柄后小于进程 ulimit -n
SERVER_MAX_CONNECTIONS=4096
# 请求头读取超时（秒）。同时约束两类连接：慢速发头（slowloris）与 keep-alive 等待下一个请求头
# 的空闲连接（hyper 1.x 没有独立的 idle timeout）。反向代理的 keepalive_timeout 必须小于本值
SERVER_HTTP1_HEADER_READ_TIMEOUT_SECS=30
# 单个请求允许的请求头数量上限，超限由 hyper 在解析阶段直接回 431（该响应体为空，不受统一响应结构约束）
SERVER_HTTP1_MAX_HEADERS=64
# 请求头读取缓冲上限（字节），超限同样回 431；不得小于 hyper 内部下限 8192，否则启动失败
SERVER_HTTP1_MAX_BUF_SIZE=16384
# 收到 SIGINT/SIGTERM 后，停止 accept 并等待在途连接排空的上限（秒），到期强制中止并记录 warn。
# 必须小于编排层的终止宽限期（如 Kubernetes terminationGracePeriodSeconds），否则进程会被 SIGKILL 硬杀
SHUTDOWN_TIMEOUT_SECS=20

# ── 数据库（仅支持 SQLite）──
# 连接串，必须以 sqlite: 开头；迁移文件与补列/建索引逻辑都是 SQLite 语法，其他 scheme 启动即拒
DATABASE_URL=sqlite://scaffold.db?mode=rwc
# 连接池最大连接数；SQLite 写入是串行的，该值过大只会增加锁竞争
DATABASE_MAX_CONNECTIONS=10
# 连接池最小连接数（常驻连接），必须 ≤ 最大连接数
DATABASE_MIN_CONNECTIONS=1
# 建立新连接的超时（秒），超时视为连接失败
DATABASE_CONNECT_TIMEOUT_SECS=8
# 从连接池取连接的最长等待时间（秒）。池耗尽时按此超时快速失败，避免请求被无限挂住
DATABASE_ACQUIRE_TIMEOUT_SECS=3
# 空闲连接回收时间（秒），超过该时长未使用的连接被关闭
DATABASE_IDLE_SECS=60
# /api/v1/system/ready 探测数据库的超时（秒）；探测失败返回 503，是编排系统判定是否接流量的依据
DATABASE_READY_PROBE_TIMEOUT_SECS=2
# 是否打印 SQLx 的 SQL 日志；生产环境建议保持 false，避免把 SQL 与参数写进日志
DATABASE_SQLX_LOGGING=false

# ── JWT ──
# 签名密钥，至少 32 字符且必填；生产环境禁止使用本文件的示例值（否则拒绝启动）
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-characters
# 签发方（iss），校验令牌时比对
JWT_ISSUER=axum-service-scaffold
# 受众（aud），校验令牌时比对
JWT_AUDIENCE=axum-service-clients
# 访问令牌有效期（分钟），必须大于 0
JWT_ACCESS_TOKEN_TTL_MINUTES=120

# ── 日志 ──
# 日志过滤规则（tracing 的 EnvFilter 语法）；写错（如不存在的级别）会拒绝启动，不会静默回退
LOG_FILTER=info,tower_http=info
# 输出格式。TEXT=单行文本；JSON=单行 JSON（事件字段平铺，span 字段在 span 对象内），便于按字段检索。
# 控制台层与文件层同格式；JSON 模式下控制台自动关闭 ANSI 着色
LOG_FORMAT=TEXT
# 日志时间戳的时区偏移（小时），仅影响展示，不影响 timestamp 语义
LOG_UTC_OFFSET_HOUR=8
# 日志时间戳的时区偏移（分钟）
LOG_UTC_OFFSET_MINUTE=0
# 日志时间戳的时区偏移（秒）
LOG_UTC_OFFSET_SECOND=0
# 日志文件名前缀，如 app.2026-04-22.log
LOG_FILENAME_PREFIX=app
# 日志文件名后缀
LOG_FILENAME_SUFFIX=log
# 时间轮转策略：DAILY / HOURLY / MINUTELY / WEEKLY / NEVER，其他取值拒绝启动
LOG_ROTATION=DAILY
# 已归档日志文件的保留数量，超出的按修改时间删除最旧的；必须大于 0
LOG_MAX_LOG_FILES=60
# 单个日志文件大小上限（字节，默认 64 MiB），超限归档换新文件；必须大于 0。
# 这是时间轮转之外的硬上限，防止持续过载下单文件涨到 GB 级
LOG_MAX_FILE_BYTES=67108864
# 每秒最多落盘的日志条数，超出的条目被丢弃并在下一个窗口写一条汇总行；0 表示不限速（合法值）。
# 用于兜底「即使降级了等级，日志量仍然失控」的场景
LOG_MAX_EVENTS_PER_SEC=2000
# 日志目录；相对路径以进程工作目录为基准，目录不存在会自动创建
LOG_OUT_DIR=./log
# 分批落盘：内存缓冲满 N 条触发一次落盘；必须大于 0
LOG_BATCH_MAX_EVENTS=50
# 分批落盘：距上次落盘超过 N 秒强制落盘一次；必须大于 0。进程退出时剩余缓冲也会落盘
LOG_BATCH_FLUSH_INTERVAL_SECS=3

# ── 中间件容量 ──
# 单请求整体超时（秒），覆盖排队等待与处理，超时返回 408 Json 响应；必须大于 0
MIDDLEWARE_REQUEST_TIMEOUT_SECS=10
# 拿到背压队列名额后，等待并发许可的上限（秒），超时返回 503{reason="queue_wait_timeout"}；
# 必须大于 0 且不得大于 MIDDLEWARE_REQUEST_TIMEOUT_SECS（否则等待时间会被总超时截断）
MIDDLEWARE_QUEUE_WAIT_TIMEOUT_SECS=5
# 请求体最大字节数，超限返回 413；按 Content-Length 先行拒绝，分块传输按实际累计字节拒绝
MIDDLEWARE_MAX_BODY_BYTES=2097152
# 单个请求 URI 的长度上限（字节），超限返回 414；应在路由匹配之前拒绝，避免写进日志与指标
MIDDLEWARE_MAX_URI_BYTES=8192
# 全局同时在途请求上限，超出的请求进入背压队列等待；必须大于 0
MIDDLEWARE_MAX_CONCURRENCY=256
# 背压等待队列深度，队列满后立即返回 503，不无限堆积；必须大于 0
MIDDLEWARE_BACKPRESSURE_QUEUE=256
# 进程级全局限速额度：每个周期允许的请求数，超出返回 429；必须大于 0。单实例语义，多实例需网关兜底
MIDDLEWARE_RATE_LIMIT_REQUESTS=32768
# 限流周期长度（秒），必须大于 0
MIDDLEWARE_RATE_LIMIT_PERIOD_SECS=1
# Host 白名单，逗号分隔；留空表示不校验。生产环境必须非空且不含 * 通配（否则拒绝启动）。
# 条目不含端口时匹配任意端口，含端口时精确匹配（支持 [::1]:8080）；不匹配返回 421，缺少 Host 返回 400
HTTP_ALLOWED_HOSTS=
# 可信反向代理网段（CIDR 或单个 IP），逗号分隔。只有直连对端落在此范围内时才采信
# X-Forwarded-For / X-Real-IP，并按信任链从右向左取第一个不可信地址；留空则完全忽略转发头
MIDDLEWARE_TRUSTED_PROXIES=
# HSTS 开关。默认跟随 APP_ENV（production 开启）；显式赋值（含 false）会覆盖该默认值，故此处注释掉。
# 仅在全链路 HTTPS 确认后才应开启
# MIDDLEWARE_HSTS_ENABLED=false
# HSTS 的 max-age（秒）
MIDDLEWARE_HSTS_MAX_AGE_SECS=31536000
# HSTS 是否包含 includeSubDomains；要求 HSTS 已开启
MIDDLEWARE_HSTS_INCLUDE_SUBDOMAINS=false
# HSTS 是否包含 preload；要求同时开启 includeSubDomains 且 max-age ≥ 31536000，否则拒绝启动
MIDDLEWARE_HSTS_PRELOAD=false
# 允许跨域的来源白名单，逗号分隔（如 https://a.example,https://b.example）；每个条目必须是合法 header 值。
# 留空表示不下发任何 CORS 放行头（等于关闭），单值 * 表示放行全部来源（生产环境不建议）
MIDDLEWARE_CORS_ALLOWED_ORIGINS=

# ── 中间件开关（生产环境禁止关闭安全关键项，除非 MIDDLEWARE_ALLOW_INSECURE_PRODUCTION=true）──
# 请求 ID：生成并回写 x-request-id，日志靠它做请求关联
MIDDLEWARE_REQUEST_ID_ENABLED=true
# 访问日志：关闭后不再输出访问日志（指标不受影响）
MIDDLEWARE_ACCESS_LOG_ENABLED=true
# 响应压缩：关闭后不下发 gzip（错误响应本身永不压缩）
MIDDLEWARE_COMPRESSION_ENABLED=true
# 安全响应头：nosniff / X-Frame-Options / Referrer-Policy / Cache-Control: no-store，以及可选的 HSTS
MIDDLEWARE_SECURITY_HEADERS_ENABLED=true
# 单请求超时：关闭后慢请求不再被 408 打断（生产环境安全关键项）
MIDDLEWARE_TIMEOUT_ENABLED=true
# 请求体限制：关闭后不限制请求体大小（生产环境安全关键项）
MIDDLEWARE_BODY_LIMIT_ENABLED=true
# 并发限制：关闭后不限制在途请求数（生产环境安全关键项）
MIDDLEWARE_CONCURRENCY_LIMIT_ENABLED=true
# 背压：关闭后不再有等待队列与快速拒绝，压力直接传导到下游（生产环境安全关键项）
MIDDLEWARE_BACKPRESSURE_ENABLED=true
# 限流：关闭后不做全局限速（生产环境安全关键项）
MIDDLEWARE_RATE_LIMIT_ENABLED=true
# 生产环境可关闭上述安全关键开关（需上游代理提供同等保护）。与 APP_ALLOW_INSECURE_PRODUCTION 是两条
# 互不影响的豁免：前者只管构建画像，后者只管安全中间件。危险开关
MIDDLEWARE_ALLOW_INSECURE_PRODUCTION=false

# ── Prometheus 指标（/metrics，与业务接口同端口 + Bearer 令牌鉴权）──
# 是否启用指标与 /metrics 端点；false 时全局 recorder 不安装、端点完全不注册
METRICS_ENABLED=true
# 采集令牌：至少 16 字符，生产环境禁止使用本文件的示例值（否则拒绝启动）。
# 令牌不匹配时返回 404（不暴露端点存在）；注意全局限速同样作用于 /metrics
METRICS_TOKEN=change-me-to-a-random-metrics-token
